# Copy to .env

APP_NAME=赣书院·智典
ENV=dev
DEBUG=true
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=3600

# MySQL (via docker-compose on localhost)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=georag
DB_PASSWORD=georag_pass
DB_NAME=georag

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Qdrant (unused when RAG_VECTOR_ENABLED=false)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# ---- LLM provider ----
# "minimax" = MiniMax cloud (Anthropic Messages API); "mimo" = MiMo cloud;
# "ollama" = local Ollama.
LLM_PROVIDER=minimax
DEFAULT_CHAT_MODEL=MiniMax-M2.7

# MiniMax — Anthropic-compatible API.
# Keep real keys out of git. Put your key in backend/.env or inject it through
# the environment as MINIMAX_API_KEY.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_MAX_TOKENS=2048

# MiMo (小米) — Anthropic-compatible API.
# 安全：请到 https://platform.xiaomimimo.com 重置 Key 后填入这里（或用环境变量 MIMO_API_KEY 注入）。
# 切勿把真实 Key 提交到 git。
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/anthropic
# mimo-v2.5 = 全模态(可识图)；mimo-v2.5-pro 仅文本，图文务必用 mimo-v2.5
MIMO_MODEL=mimo-v2.5
MIMO_MAX_TOKENS=2048

# Ollama (only used when LLM_PROVIDER=ollama; embedding unused when vector off)
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3:latest
EMBEDDING_DIM=1024

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Uploads
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- RAG (书院: BM25 关键词检索, 无向量, 单域不设语义门控) ----
RAG_VECTOR_ENABLED=false
RAG_GATE_ENABLED=true
RAG_CONTEXT_MAX_CHARS=3200
RERANK_DEFAULT_ENABLED=false
QA_AUTO_GENERATE_ON_INGEST=false
# 图文展示与多模态喂图上限
RAG_MAX_IMAGES=4
RAG_MAX_IMAGES_TO_LLM=4
# 自备书院图片目录：递归遍历，按书院名在文件路径中子串匹配（无需按书院分文件夹）
ACADEMY_IMAGES_DIR=D:/workplace/GeoRag/书院文化图片
ACADEMY_IMAGES_MANIFEST=manifest.json

# legacy = 纯 PyMuPDF 抽文字(零本地模型,推荐)；mineru = 本地版面解析(可抽图,但大 PDF 易失败)
PDF_PARSER=legacy
PDF_IMAGE_EXTRACTOR=mineru
MINERU_OUTPUT_DIR=D:/workplace/GeoRag/mineru_out
MINERU_LANG=ch
MINERU_BACKEND=pipeline
MINERU_PARSE_METHOD=auto
MINERU_MODEL_SOURCE=huggingface
HF_HOME=D:/workplace/GeoRag/models/huggingface
HF_ENDPOINT=

# AI 合影：NanoApple 图像生成（Gemini 3.1 多图参考融合）
GEMINI_API_STYLE=google
GEMINI_API_BASE_URL=https://cn.nanoapple.cc/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-image-preview-time

# GPT Image 2（可选，当前仅文生图，不支持参考图融合）
GPT_IMAGE_API_BASE_URL=https://cn.nanoapple.cc/v1
GPT_IMAGE_API_KEY=
GPT_IMAGE_MODEL=gpt-image-2-time
GPT_IMAGE_SIZE=1024x1024
GPT_IMAGE_QUALITY=standard
GPT_IMAGE_STYLE=vivid
