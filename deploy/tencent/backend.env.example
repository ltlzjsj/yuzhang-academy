# Copy this file to backend.env before running docker compose.
# Do not commit backend.env.

APP_NAME=赣书院·智典
DEBUG=false
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=3600

# MySQL user/password must match deploy.env.
DB_USER=georag
DB_PASSWORD=change-this-db-password
DB_NAME=georag

# MiniMax Anthropic-compatible API.
LLM_PROVIDER=minimax
DEFAULT_CHAT_MODEL=MiniMax-M2.7
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_MAX_TOKENS=2048

# 历史名人语音对话 (MiMo ASR/TTS) —— 即使对话用 MiniMax, 语音仍走 MiMo。
# tp- 开头的 token-plan key 必须配 token-plan-cn host (api.xiaomimimo.com 会 401)。
# 不填则语音功能 (录音识别/语音作答) 不可用, 但不影响其余功能。
MIMO_API_KEY=
MIMO_AUDIO_BASE_URL=https://token-plan-cn.xiaomimimo.com
# 以下一般用默认即可:
# MIMO_ASR_MODEL=mimo-v2.5-asr
# MIMO_TTS_MODEL=mimo-v2.5-tts
# MIMO_TTS_VOICEDESIGN_MODEL=mimo-v2.5-tts-voicedesign

# Security: change before production.
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAMES=

# Uploads and static image assets inside containers.
UPLOAD_DIR=/app/uploads
ACADEMY_IMAGES_DIR=/app/academy_images
ACADEMY_IMAGES_MANIFEST=manifest.json

# Frontend is served by nginx on the same origin, so CORS can stay narrow.
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Cloud deployment is BM25-only: no Qdrant/vector DB, no MinerU.
RAG_VECTOR_ENABLED=false
RAG_GATE_ENABLED=true
RAG_CONTEXT_MAX_CHARS=3200
RERANK_DEFAULT_ENABLED=false
QA_AUTO_GENERATE_ON_INGEST=false
RAG_MAX_IMAGES=4
RAG_MAX_IMAGES_TO_LLM=0

PDF_PARSER=legacy
PDF_IMAGE_EXTRACTOR=none
MINERU_OUTPUT_DIR=/app/mineru_out
MINERU_LANG=ch
MINERU_BACKEND=pipeline
MINERU_PARSE_METHOD=auto
MINERU_MODEL_SOURCE=local
HF_HOME=
HF_ENDPOINT=

WARM_MODELS_ON_START=false
WARM_RERANKER_ON_START=false
