- PATCH_DETAIL 从 0.55/0.7 统一提到 1.0（含新增的罗从彦、王阳明）
  仿真：模型输出约等于原图高斯模糊 1.8；w=0.55 只恢复约 28% 细节，
  w=1.0 可恢复到 83~89% 且不过冲 -> 解决"嘴部还有一点模糊"
- 江万里换成 2026-10 新素材（说话 139 帧 / 待机 107 帧，720x1280）
  嘴部动作量 2.32（旧版 1.67）偏小，新增 MOUTH_GAIN: jiangwanli_lt = 1.25
- 引擎侧验证：江万里 139 帧 full/face(256x256)/coords 完全对齐
---
 avatars/wav2lip_avatar.py | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/avatars/wav2lip_avatar.py b/avatars/wav2lip_avatar.py
index c6de264..bdd7014 100644
--- a/avatars/wav2lip_avatar.py
+++ b/avatars/wav2lip_avatar.py
@@ -103,6 +103,7 @@ def load_avatar(avatar_id):
 MOUTH_GAIN = {
     "zhuxi_lt": 1.25,
     "luxiangshan_lt": 1.25,   # 2026-10 新素材嘴部动作量 2.06（偏小），放大到接近罗从彦
+    "jiangwanli_lt": 1.25,    # 2026-10 新素材嘴部动作量 2.32（偏小），放大到接近罗从彦
 }
 
 # ---------------------------------------------------------------------------
@@ -113,10 +114,15 @@ MOUTH_GAIN = {
 # 默认 0（不干预）；按人物开启，先小后大调（0.5 ~ 0.9）。
 # ---------------------------------------------------------------------------
 PATCH_DETAIL = {
-    "jiangwanli_lt": 0.55,
-    "luxiangshan_lt": 0.55,
-    "lvzuqian_lt": 0.55,
-    "zhuxi_lt": 0.55,   # 2026-10 新素材嘴部细节更足（锐度约为罗从彦 1.8 倍），更需要补纹理
+    # 2026-10 仿真：模型重绘区约等于「原图高斯模糊 1.8」。
+    # w=0.55 只能恢复约 28% 的细节（仍显模糊），w=1.0 可恢复到 83~89% 且不过冲。
+    # 六个数字人统一用 1.0，保证贴回区的纹理接近原始帧。
+    "jiangwanli_lt": 1.0,
+    "luxiangshan_lt": 1.0,
+    "lvzuqian_lt": 1.0,
+    "zhuxi_lt": 1.0,
+    "luocongyan_lt": 1.0,
+    "wangyangming_lt": 1.0,
 }
 
 # 防纯黑保护：增益/细节注入都可能把嘴唇一带压到 0（观感就是"一小片变黑"）。
