 avatars/wav2lip_avatar.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/avatars/wav2lip_avatar.py b/avatars/wav2lip_avatar.py
index 2bb44cb..4be495a 100644
--- a/avatars/wav2lip_avatar.py
+++ b/avatars/wav2lip_avatar.py
@@ -45,6 +45,13 @@ from utils.image import read_imgs, mirror_index
 from utils.device import initialize_device
 from registry import register
 
+# PyTorch 默认把内部算子线程池开到 CPU 核数；本项目每批张量很小（16×6×256×256），
+# 多线程只会空转抢 CPU —— 实测说话期间进程 CPU 从 3.2 核降到 0.88 核，帧率与画面不变。
+# 想恢复默认多线程行为：设环境变量 LT_TORCH_THREADS=0。
+_lt_threads = os.environ.get("LT_TORCH_THREADS", "1")
+if _lt_threads.isdigit() and int(_lt_threads) > 0:
+    torch.set_num_threads(int(_lt_threads))
+
 device = initialize_device()
 logger.info('Using {} for inference.'.format(device))
 
