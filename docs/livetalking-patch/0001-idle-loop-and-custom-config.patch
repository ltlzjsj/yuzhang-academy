                 self.speaking = False
                 audiotype = audio_frames[0].type
                 if self.custom_index.get(audiotype) is not None: #有自定义视频
-                    mirindex = mirror_index(len(self.custom_img_cycle[audiotype]),self.custom_index[audiotype])
-                    target_frame = self.custom_img_cycle[audiotype][mirindex]
+                    # 待机（静音）画面改为「只正放」循环：原实现用 mirror_index 正放一遍再倒放
+                    # 一遍，视觉上刚播过的动作会反向重演，看起来像重复。
+                    cycle_frames = self.custom_img_cycle[audiotype]
+                    mirindex = self.custom_index[audiotype] % len(cycle_frames)
+                    target_frame = cycle_frames[mirindex]
                     self.custom_index[audiotype] += 1
                 else:
                     target_frame = self.frame_list_cycle[idx]
diff --git a/avatars/wav2lip_avatar.py b/avatars/wav2lip_avatar.py
index e69c72e..2bb44cb 100644
--- a/avatars/wav2lip_avatar.py
+++ b/avatars/wav2lip_avatar.py
@@ -138,11 +138,25 @@ class LipReal(BaseAvatar):
         pred = pred.cpu().numpy().transpose(0, 2, 3, 1) * 255.
         return pred
 
+    def _sharpen_lower_face(self, face_img: np.ndarray) -> np.ndarray:
+        """wav2lip 重绘的下半张脸天生偏软（胡须、轮廓被抹平）。
+
+        只对下半部分做一次轻微反锐化，让贴回后的嘴部与原始画面更接近；
+        上半张脸（眼睛、额纹）保持原样，避免出现锐化噪点。
+        """
+        h = face_img.shape[0]
+        split = h // 2
+        top, low = face_img[:split], face_img[split:]
+        blur = cv2.GaussianBlur(low, (0, 0), 1.0)
+        low = cv2.addWeighted(low, 1.5, blur, -0.5, 0)
+        return np.vstack([top, low])
+
     def paste_back_frame(self,pred_frame,idx:int):
         bbox = self.coord_list_cycle[idx]
         combine_frame = self.frame_list_cycle[idx].copy()
         y1, y2, x1, x2 = bbox
         res_frame = cv2.resize(pred_frame.astype(np.uint8),(x2-x1,y2-y1))
+        res_frame = self._sharpen_lower_face(res_frame)
         combine_frame[y1:y2, x1:x2] = res_frame
         return combine_frame
 
